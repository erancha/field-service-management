# Keep build contexts small: never ship dependency trees, build outputs, VCS, or local secrets. Size
# matters beyond build speed — a remote deployment sends this context to the box's Docker daemon over
# SSH, so anything listed here is bandwidth paid on every deploy.
**/node_modules
**/.venv
**/dist
**/__pycache__
**/*.pyc
**/.pytest_cache
.git
backend/.env
scripts/aws-config.sh
# Knowledge-base documents fetched to exercise the app locally; no image build reads them.
/samples

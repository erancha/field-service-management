# Keep build contexts small: never ship dependency trees, build outputs, VCS, or local settings.
.git
**/.env*
scripts/lib/secrets.sh
scripts/lib/params.sh
scripts/lib/aws-config.sh
scripts/lib/.ssh
backup
.superpowers
docs
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.*_cache
# Knowledge-base documents fetched to exercise the app locally; no image build reads them.
/samples
